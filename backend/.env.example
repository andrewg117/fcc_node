# Copy to .env (gitignored) and fill in real values.
# Supabase: use the Session pooler string (Project Settings > Database > Connection string),
# with the scheme changed to postgresql+asyncpg://
DATABASE_URL=
# At least 32 characters. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Supabase Storage. URL: Project Settings > Data API.
# Key: Project Settings > API Keys, a secret key (sb_secret_...) or the legacy service_role key.
# Server only: never put the key in client/.env.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional, defaults to fcc_media.
# MEDIA_BUCKET=fcc_media